extends layout
include partials/pagehead

block content
  +pagehead("Registration", "Get on the list that hears first.", "Most of what we finish is spoken for before it is advertised. Registration takes a few minutes, we answer within two working days, and approval opens exact addresses, full terms, floor plans and the documents behind them.", hero)

  section.band.page
    .detail-grid
      form.stack(method="post" action="/register")
        if offer
          .field
            label(for="offer") Enquiry about
            input#offer(name="offer" type="text" value=offer readonly)
        .field
          label(for="name") Your name
          input#name(name="name" type="text" autocomplete="name" required)
        .field
          label(for="email") Email address
          input#email(name="email" type="email" autocomplete="email" required)
        .field
          label(for="market") Where are you looking
          select#market(name="market")
            option(value="") No preference
            each country in countries
              option(value=country.code)= country.name
        .field
          label(for="intent") What are you looking for
          select#intent(name="intent")
            option(value="sale") To buy
            option(value="long_lease") To lease long term
            option(value="corporate_let") A corporate let
        .field
          label(for="requirement") Your requirement
          textarea#requirement(name="requirement" rows="6" placeholder="Size, timing, and anything a building has to have.")
        .button-row
          button.button(type="submit") Submit registration
        p.note We use what you write here to judge whether we can help, and for nothing else. We never publish your details and we do not pass them on.

      aside.aside
        h2 What happens next
        p A member of this office reads it and either approves you or tells you plainly that we cannot help. We would rather say no in two days than string you along for a month.
        p Approval opens the full portfolio and lets you book a viewing. No payment is possible at this stage, or at any stage before we have approved an application in writing.
