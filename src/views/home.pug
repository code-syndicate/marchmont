extends layout
include partials/schedule

block content
  section.hero
    figure.hero-media
      img(src=hero.src srcset=hero.srcset sizes=hero.sizes alt=hero.alt width=hero.width height=hero.height fetchpriority="high" decoding="async")
    .page
      .hero-inner
        p.eyebrow A private collection in #{cityCount} cities
        h1 Residences, houses and office floors we own and offer directly.
        p.lede We convert industrial buildings into residences and offices, and hold a number of new build houses. #{totalCount} properties are available now, for sale, on long lease, or on a corporate let.
        .button-row
          a.button(href="/portfolio") View the collection
          a.button.button-quiet(href="/gallery") See the buildings

  .page
    dl.index-strip
      div
        dt In the collection
        dd= totalCount
      div
        dt Cities
        dd= cityCount
      div
        dt Currencies
        dd= currencyCount
      div
        dt Oldest building
        dd= oldestYear

  section.band.page
    .section-head
      div
        p.eyebrow Available now
        h2 Current availability
      a(href="/portfolio") View all #{totalCount} properties
    +cards(featured)

  section.band.band-rule.page
    .section-head
      div
        p.eyebrow Ways to take space
        h2 Purchase, long lease and corporate lets
    .routes
      each route in routes
        article.route
          .route-frame
            img(src=route.image.src srcset=route.image.srcset sizes=route.image.sizes alt=route.image.alt width=route.image.width height=route.image.height loading="lazy" decoding="async")
          .route-body
            span.route-count #{route.count} available
            h3
              a(href=route.href)= route.title
            p= route.blurb

  section.band.band-rule.band-raised
    .page
      .section-head
        div
          p.eyebrow Locations
          h2 Where we own buildings
      p.lede Nash Luxury Realty concentrates on a small number of districts in each city and acquires repeatedly within them. Local knowledge of planning, party wall history and contractors shortens every conversion we undertake.
      ul.cities
        each city in cities
          li
            a(href=`/portfolio?city=${encodeURIComponent(city.name)}`)
              = city.name
              span #{city.count}

  section.band.band-rule.page
    .policy
      div
        p.eyebrow Buying and leasing directly
        h2 You deal with the owner
        p.lede Every building on this site is owned by Nash Luxury Realty. There is no vendor chain to wait on, no third party interpreting your questions, and no separate agency fee. Survey documents, title, floor plates and service charge history are all held in this office.
      ol.steps
        li
          div
            h3 Register your requirement
            p Tell us the space, location and timing you need. Registration is reviewed within two working days and opens exact addresses, full terms, floor plans and supporting documents.
        li
          div
            h3 Receive detailed information
            p Floor plates, load ratings, energy performance, service charge history and survey findings are provided in full for any building you are considering.
        li
          div
            h3 View with the building manager
            p Viewings are arranged by appointment and accompanied by the member of staff responsible for that building.
        li
          div
            h3 Agree terms and complete
            p Reservation fees, holding deposits and first payments are taken only after your application has been approved in writing, for a fixed amount, within a defined payment window.

  section.closer
    figure.closer-media
      img(src=closer.src srcset=closer.srcset sizes=closer.sizes alt=closer.alt width=closer.width height=closer.height loading="lazy" decoding="async")
    .page
      .closer-inner
        h2 Registered clients see a release first
        p.lede Nash Luxury Realty holds a small portfolio and completed conversions are frequently reserved before they are advertised. Registered clients are notified first and can arrange a viewing immediately.
        .button-row
          a.button(href="/register") Register
          a.button.button-quiet(href="/contact") Contact us
