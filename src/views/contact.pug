extends layout

block content
  section.band-tight.page
    p.eyebrow Contact
    h1 Speak to someone at the house.
    p.lede Questions about a specific building are answered fastest if you name it. General enquiries are welcome either way.

  section.band-tight.page
    .detail-grid
      form.stack(method="post" action="/contact")
        .field
          label(for="name") Your name
          input#name(name="name" type="text" autocomplete="name" required)
        .field
          label(for="email") Email address
          input#email(name="email" type="email" autocomplete="email" required)
        .field
          label(for="message") Your message
          textarea#message(name="message" rows="8" required)
        .button-row
          button.button(type="submit") Send message
      aside.aside
        h2 Enquiries
        p
          a(href="mailto:enquiries@marchmont.example") enquiries@marchmont.example
        p Registrations are reviewed within two working days. Viewings are by appointment and walked by someone from this office.
        a.button.button-quiet(href="/register") Register an interest
