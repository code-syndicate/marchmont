extends layout
include partials/pagehead

block content
  +pagehead("Contact", "Ask us about a building.", "We hold the survey, the title and the service charge history for everything on this site, so a question about a specific building gets a real answer rather than a call back. Name the building and you will hear sooner.", hero)

  section.band.page
    .detail-grid
      form.stack(method="post" action="/contact")
        .field
          label(for="name") Your name
          input#name(name="name" type="text" autocomplete="name" required)
        .field
          label(for="email") Email address
          input#email(name="email" type="email" autocomplete="email" required)
        .field
          label(for="message") Your message
          textarea#message(name="message" rows="8" required)
        .button-row
          button.button(type="submit") Send message
      aside.aside
        h2 Enquiries
        p
          a(href="mailto:enquiries@marchmont.example") enquiries@marchmont.example
        p Registrations are reviewed within two working days. Viewings are by appointment and walked by someone from this office, not a call centre and not a lockbox.
        a.button.button-quiet(href="/register") Register an interest
