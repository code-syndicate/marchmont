extends layout
include partials/pagehead

block content
  +pagehead("Contact", "Contact Marchmont.", "Enquiries about a specific building are answered fastest if you name it in your message. Survey findings, title documents and service charge history are held in this office for every property we market.", hero)

  section.band.page
    .detail-grid
      form.stack(method="post" action="/contact")
        .field
          label(for="name") Your name
          input#name(name="name" type="text" autocomplete="name" required)
        .field
          label(for="email") Email address
          input#email(name="email" type="email" autocomplete="email" required)
        .field
          label(for="message") Your message
          textarea#message(name="message" rows="8" required)
        .button-row
          button.button(type="submit") Send message
      aside.aside
        h2 Enquiries
        p
          a(href="mailto:enquiries@marchmont.house") enquiries@marchmont.house
        p Registrations are reviewed within two working days. Viewings are arranged by appointment and accompanied by the member of staff responsible for the building.
        a.button.button-quiet(href="/register") Register an interest
