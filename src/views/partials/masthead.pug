header.masthead
  .page
    .masthead-inner
      a.wordmark(href="/") Marchmont
      nav.nav(aria-label="Primary")
        a(href="/portfolio" aria-current=(nav === "portfolio" ? "page" : false)) Properties
        a(href="/gallery" aria-current=(nav === "gallery" ? "page" : false)) Gallery
        a(href="/about" aria-current=(nav === "about" ? "page" : false)) About
        a(href="/contact" aria-current=(nav === "contact" ? "page" : false)) Contact
        if account
          a(href="/account" aria-current=(nav === "account" ? "page" : false)) Your account
        else
          a(href="/register" aria-current=(nav === "register" ? "page" : false)) Register
          a(href="/signin" aria-current=(nav === "signin" ? "page" : false)) Sign in
      details.nav-drawer
        summary Menu
        ul
          li: a(href="/portfolio" aria-current=(nav === "portfolio" ? "page" : false)) Properties
          li: a(href="/gallery" aria-current=(nav === "gallery" ? "page" : false)) Gallery
          li: a(href="/about" aria-current=(nav === "about" ? "page" : false)) About
          li: a(href="/contact" aria-current=(nav === "contact" ? "page" : false)) Contact
          if account
            li: a(href="/account" aria-current=(nav === "account" ? "page" : false)) Your account
          else
            li: a(href="/register" aria-current=(nav === "register" ? "page" : false)) Register
            li: a(href="/signin" aria-current=(nav === "signin" ? "page" : false)) Sign in
