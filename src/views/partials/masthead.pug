header.masthead
  .page
    .masthead-inner
      a.wordmark(href="/") Marchmont
      nav.nav(aria-label="Primary")
        a(href="/portfolio" aria-current=(nav === "portfolio" ? "page" : false)) Portfolio
        a(href="/about" aria-current=(nav === "about" ? "page" : false)) The house
        a(href="/register" aria-current=(nav === "register" ? "page" : false)) Register
        a(href="/contact" aria-current=(nav === "contact" ? "page" : false)) Contact
      details.nav-drawer
        summary Menu
        ul
          li: a(href="/portfolio" aria-current=(nav === "portfolio" ? "page" : false)) Portfolio
          li: a(href="/about" aria-current=(nav === "about" ? "page" : false)) The house
          li: a(href="/register" aria-current=(nav === "register" ? "page" : false)) Register
          li: a(href="/contact" aria-current=(nav === "contact" ? "page" : false)) Contact
