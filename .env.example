NODE_ENV=development
PORT=3000
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=marchmont

# Absolute origin the site is served from. Canonical links, Open Graph tags and
# the sitemap are built from it. Defaults to http://localhost:$PORT.
PUBLIC_URL=http://localhost:3000
# At least 32 characters. Signs the CSRF tokens on the public forms.
SESSION_SECRET=change-me-to-at-least-thirty-two-characters
# unsplash serves the photography from its CDN. sandbox draws its own images
# at the same dimensions and needs no network. Either is valid in any
# environment.
IMAGES_PROVIDER=unsplash

# osm draws locator maps from OpenStreetMap tiles, which adds that host to the
# image policy. sandbox draws a schematic locator locally and needs no network.
MAPS_PROVIDER=sandbox

# log writes each message to the service log, which is enough to finish an
# account without a mail vendor. sandbox records messages in memory instead.
MAIL_PROVIDER=log
