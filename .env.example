NODE_ENV=development
PORT=3000
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=marchmont
SESSION_SECRET=change-me-to-at-least-thirty-two-characters
# unsplash serves the photography from its CDN. sandbox serves /images
# locally and needs no network. Either is valid in any environment.
IMAGES_PROVIDER=unsplash
