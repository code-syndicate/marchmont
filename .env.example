NODE_ENV=development
PORT=3000
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=marchmont

# Absolute origin the site is served from. Canonical links, Open Graph tags and
# the sitemap are built from it. Defaults to http://localhost:$PORT.
PUBLIC_URL=http://localhost:3000
# At least 32 characters. Signs the CSRF tokens on the public forms.
SESSION_SECRET=change-me-to-at-least-thirty-two-characters
# unsplash serves the photography from its CDN. sandbox draws its own images
# at the same dimensions and needs no network. Either is valid in any
# environment.
IMAGES_PROVIDER=unsplash
